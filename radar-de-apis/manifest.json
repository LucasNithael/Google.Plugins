{
  "manifest_version": 3,
  "name": "Radar de APIs",
  "version": "1.0.0",
  "description": "Veja as chamadas HTTP da aba em um painel lateral.",
  "minimum_chrome_version": "116",
  "permissions": ["webRequest", "storage", "sidePanel", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Radar de APIs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
